# ==========================================================
#  PetCare - Variables de entorno
#  Copiar a ".env" y completar. NUNCA versionar el .env real.
# ==========================================================

# ─── Django ───────────────────────────────────────────────
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True
# Separados por coma. En EC2: IP pública / dominio (ej: petcare.cl,www.petcare.cl)
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL ───────────────────────────────────────────
DB_NAME=petcare
DB_USER=petcare_user
DB_PASSWORD=cambia-esta-password
DB_HOST=localhost
DB_PORT=5432
# Segundos que se reutiliza una conexión (0 = cerrar en cada request)
DB_CONN_MAX_AGE=60

# ─── Seguridad / HTTPS (activar en producción detrás de Nginx con TLS) ─
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Segundos de HSTS (0 = desactivado). En producción: 31536000
SECURE_HSTS_SECONDS=0

# Orígenes confiables para CSRF (con esquema). Ej: https://petcare.cl
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Orígenes del front-end autorizados a llamar a la API con cookies
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Sesión ───────────────────────────────────────────────
# Duración de la sesión del personal en segundos (8 h = una jornada)
SESSION_COOKIE_AGE=28800

# ─── Archivos estáticos / media (servidos por Nginx en producción) ───
# Rutas absolutas en el servidor. Si se omiten, se usan carpetas dentro del proyecto.
STATIC_ROOT=
MEDIA_ROOT=

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
